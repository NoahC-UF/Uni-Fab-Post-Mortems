# Copy this file to ".env" (same folder) and fill in the values yourself.
# NEVER share .env or paste its values into chat. It is ignored by git.
# Do not put quotes around values or spaces around the "=".

# --- Epicor connection (leave empty while USE_MOCK_DATA=true) ---
# e.g. https://xxxx.epicorsaas.com/SaaSxxx
EPICOR_BASE_URL=
EPICOR_COMPANY=
# Created in API Key Maintenance
EPICOR_API_KEY=
# Read-only integration user with BAQ access only
EPICOR_USERNAME=
EPICOR_PASSWORD=

# --- Data source ---
# true  = use realistic fake jobs (demo/development)
# false = read from Epicor BAQs (or from the import folder)
USE_MOCK_DATA=true

# --- App ---
# A long random string used to sign login sessions. To make one, run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET_KEY=

# Port the app listens on: http://<this-pc-name>:8080
PORT=8080
# 127.0.0.1 = this PC only. 0.0.0.0 = other PCs on the network can connect
# (also needs the Windows Firewall rule from allow_network.bat).
HOST=127.0.0.1
