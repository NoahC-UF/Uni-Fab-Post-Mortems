{% extends "base.njk" %}
{% from "_macros.njk" import colmenu, presetButtons, dateFields %}
{% block title %}Dashboard{% endblock %}
{% block head %}
<link rel="stylesheet" href="/vendor/tabulator/css/tabulator_simple.min.css">
<script src="/vendor/chart/chart.umd.min.js" defer></script>
<script src="/vendor/tabulator/js/tabulator.min.js" defer></script>
{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <div class="muted">Closed jobs from {{ f.from }} to {{ f.to }}, plus jobs still in progress.</div>
  </div>
</div>
{% set dq = ('&dir=' ~ dir) if dir else '' %}
<div class="row no-print" style="margin-bottom:14px">
  <form method="post" action="/sync" class="inline" title="Pulls open jobs and anything closed since the last sync">
    <input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn-sm" type="submit">&#8635; Sync now</button></form>
  <small class="muted">{% if lastSync %}Last sync {{ lastSync.started_at | dateTime }} UTC ({{ lastSync.status }}){% else %}Never synced{% endif %}</small>
  <div class="date-tools">
    {{ presetButtons(presets) }}
    <span class="muted">|</span>
    <form method="get" action="/" class="date-range">
      {% if dir %}<input type="hidden" name="dir" value="{{ dir }}">{% endif %}
      {{ dateFields(f.from, f.to) }}
    </form>
  </div>
</div>

{% if not hasData %}
<div class="card">
  <h2>No Job Data Yet</h2>
  <p>Nothing has been synced. {% if user.isAdmin %}Go to <a href="/settings">Settings</a> and press <b>Sync now</b>.{% else %}Ask an Admin to run a sync.{% endif %}</p>
</div>
{% else %}

<div class="tiles">
  <div class="tile t-blue">
    <div class="label">Jobs reviewed</div>
    <div class="value">{{ d.reviewed }}</div>
    <div class="sub">closed in period · {{ d.inProgress }} in progress</div>
  </div>
  <div class="tile {{ 't-green' if d.withinTolerancePct !== null and d.withinTolerancePct >= 0.7 else 't-yellow' }}">
    <div class="label">Within tolerance</div>
    <div class="value">{{ (d.withinTolerancePct | pct) if d.withinTolerancePct !== null else 'n/a' }}</div>
    <div class="sub">{{ d.green }} green · {{ d.yellow }} yellow · {{ d.red }} red</div>
  </div>
  <div class="tile t-red">
    <div class="label">Total $ over</div>
    <div class="value">{{ d.overDollars | money0 }}</div>
    <div class="sub">flagged lines, closed jobs</div>
  </div>
  <div class="tile">
    <div class="label">Total $ under</div>
    <div class="value" style="color:var(--blue)">{{ d.underDollars | money0 }}</div>
    <div class="sub">possible over-quoting</div>
  </div>
  <div class="tile t-yellow">
    <div class="label">Open post-mortems</div>
    <div class="value">{{ d.openPostMortems }}</div>
    <div class="sub">{{ d.awaitingReview }} flagged job{{ '' if d.awaitingReview == 1 else 's' }} awaiting review{% if d.overdueActions %} · <span class="neg-bad">{{ d.overdueActions }} overdue action{{ '' if d.overdueActions == 1 else 's' }}</span>{% endif %}</div>
  </div>
</div>

<div>
  <div class="card">
    <div class="page-head" style="margin-bottom:6px">
      <h2>{% if dir == 'over' %}Top 10 Biggest $ Over-Runs{% elif dir == 'under' %}Top 10 Biggest $ Under-Runs{% else %}Top 10 Biggest $ Misses{% endif %}</h2>
      <div class="row">
        <span class="seg no-print" title="Which kind of miss the list shows and ranks by">
          <small class="muted">Show</small>
          <a class="btn btn-sm {{ 'btn-primary' if not dir }}" href="/?from={{ f.from }}&to={{ f.to }}">Both</a>
          <a class="btn btn-sm {{ 'btn-primary' if dir == 'over' }}" href="/?from={{ f.from }}&to={{ f.to }}&dir=over">Over</a>
          <a class="btn btn-sm {{ 'btn-primary' if dir == 'under' }}" href="/?from={{ f.from }}&to={{ f.to }}&dir=under">Under</a>
        </span>
        <a href="/jobs?from={{ f.from }}&to={{ f.to }}{{ ('&direction=' ~ dir) if dir }}">All flagged jobs &rarr;</a>
      </div>
    </div>
    {% if d.top.length %}
    <div class="row no-print" style="margin-bottom:8px">
      {{ colmenu() }}
      <span class="muted">Click a column title to sort, or drag it to move the column.</span>
    </div>
    <div id="topJobs" data-table="dashboard-top" data-help-scope="grid"></div>
    <script type="application/json" id="jobRows">{{ topRows | json | safe }}</script>
    <script type="application/json" id="gridMeta">{{ {'target': targetMarginPct / 100, 'dir': dir, 'marginBands': marginBands} | json | safe }}</script>
    <script type="application/json" id="colPrefs">{{ savedColumns | json | safe }}</script>
    {% else %}<div class="empty">No flagged jobs in this period.</div>{% endif %}
  </div>

  <div class="card">
    <h2>Where the Variance Is Coming From</h2>
    <div class="muted" style="margin-bottom:8px">Flagged lines by operation (materials grouped), in dollars. Hover over a bar to see the biggest jobs behind it; click it to review all of them.</div>
    {% if d.byOp.length %}
    <div class="chart-box"><canvas id="byOp"></canvas></div>
    <script type="application/json" id="byOpData">{{ {'from': f.from, 'to': f.to, 'rows': d.byOp} | json | safe }}</script>
    {% else %}<div class="empty">Nothing flagged in this period.</div>{% endif %}
  </div>
</div>
{% endif %}
{% endblock %}
{% block scripts %}
<script src="/static/dashboard.js" defer></script>
<script src="/static/job-columns.js" defer></script>
<script src="/static/dashboard-top.js" defer></script>
{% endblock %}
