{% extends "base.njk" %}
{% block title %}Flagged Jobs{% endblock %}
{% block head %}
<link rel="stylesheet" href="/vendor/tabulator/css/tabulator_simple.min.css">
<script src="/vendor/tabulator/js/tabulator.min.js" defer></script>
{% endblock %}
{% block content %}
<div class="page-head">
  <div>
    <h1>Flagged Jobs</h1>
    <div class="muted">{{ total }} job{{ '' if total == 1 else 's' }} match. Ranked by total $ impact (labour + material), biggest first.</div>
  </div>
  <a class="btn" href="/jobs/export.xlsx{{ '?' + exportQuery if exportQuery }}">&#8681; Export to Excel</a>
</div>

<form method="get" action="/jobs" class="card no-print">
  <div class="filters">
    <label>Closed from <input type="date" name="from" value="{{ f.from }}"></label>
    <label>Closed to <input type="date" name="to" value="{{ f.to }}"></label>
    <label>Job status
      <select name="status">
        <option value="all" {{ 'selected' if f.status == 'all' }}>Closed + in progress</option>
        <option value="closed" {{ 'selected' if f.status == 'closed' }}>Closed only</option>
        <option value="open" {{ 'selected' if f.status == 'open' }}>In progress only</option>
      </select>
    </label>
    <label>Flag
      <select name="flag">
        <option value="flagged" {{ 'selected' if f.flag == 'flagged' }}>Yellow + red</option>
        <option value="red" {{ 'selected' if f.flag == 'red' }}>Red only</option>
        <option value="yellow" {{ 'selected' if f.flag == 'yellow' }}>Yellow only</option>
        <option value="green" {{ 'selected' if f.flag == 'green' }}>Within tolerance</option>
        <option value="all" {{ 'selected' if f.flag == 'all' }}>All jobs</option>
      </select>
    </label>
    <label>Over / under
      <select name="direction">
        <option value="">Both</option>
        <option value="over" {{ 'selected' if f.direction == 'over' }}>Over estimate</option>
        <option value="under" {{ 'selected' if f.direction == 'under' }}>Under estimate</option>
      </select>
    </label>
    <label>Customer
      <select name="cust">
        <option value="">All customers</option>
        {% for c in options.customers %}<option value="{{ c.id }}" {{ 'selected' if f.cust == c.id }}>{{ c.name }}</option>{% endfor %}
      </select>
    </label>
    <label>Op code (flagged)
      <select name="op">
        <option value="">Any</option>
        {% for o in options.opCodes %}<option value="{{ o }}" {{ 'selected' if f.op == o }}>{{ o }}</option>{% endfor %}
      </select>
    </label>
    <label>Resource group (flagged)
      <select name="rg">
        <option value="">Any</option>
        {% for o in options.resourceGroups %}<option value="{{ o }}" {{ 'selected' if f.rg == o }}>{{ o }}</option>{% endfor %}
      </select>
    </label>
    <label>Part number <input name="part" value="{{ f.part }}" placeholder="contains..."></label>
    <label>Job number <input name="job" value="{{ f.job }}" placeholder="contains..."></label>
    <label>Min $ impact <input type="number" min="0" step="50" name="minImpact" value="{{ f.minImpact or '' }}"></label>
    <label>Post-mortem
      <select name="pm">
        <option value="">Any</option>
        <option value="none" {{ 'selected' if f.pm == 'none' }}>Not started</option>
        <option value="open" {{ 'selected' if f.pm == 'open' }}>In progress</option>
        <option value="closed" {{ 'selected' if f.pm == 'closed' }}>Closed / dismissed</option>
      </select>
    </label>
    <div class="row"><button class="btn btn-primary" type="submit">Apply filters</button> <a class="btn" href="/jobs">Reset</a></div>
  </div>
</form>

{% if rows.length %}
<div class="row no-print" style="margin-bottom:8px">
  <details>
    <summary class="btn btn-sm">Columns</summary>
    <div class="card" id="colPicker" style="position:absolute;z-index:5;margin-top:4px;min-width:200px"></div>
  </details>
  <span class="muted">Click a column title to sort. Use the boxes under the titles to filter this table further.</span>
</div>
<div id="jobsTable"></div>
<script type="application/json" id="jobRows">{{ rows | json | safe }}</script>
{% else %}
<div class="card"><div class="empty">No jobs match these filters. Try a wider date range, or set Flag to "All jobs".</div></div>
{% endif %}
{% endblock %}
{% block scripts %}<script src="/static/jobs-table.js" defer></script>{% endblock %}
