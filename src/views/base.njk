<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Post-Mortem{% endblock %} · Uni-Fab Post-Mortem</title>
  <link rel="stylesheet" href="/static/app.css">
  {% block head %}{% endblock %}
  <script src="/vendor/htmx/htmx.min.js" defer></script>
  <script src="/vendor/alpine/cdn.min.js" defer></script>
</head>
<body{% if csrf %} hx-headers='{"x-csrf-token": "{{ csrf }}"}'{% endif %}>
{% if user %}
<header class="topbar no-print">
  <div class="topbar-inner">
    <a class="brand" href="/">Uni-Fab <span>Post-Mortem</span></a>
    <nav class="nav">
      <a href="/" class="{{ 'on' if path == '/' }}">Dashboard</a>
      <a href="/jobs" class="{{ 'on' if path == '/jobs' or path.startsWith('/jobs/') }}">Flagged Jobs</a>
      <a href="/postmortems" class="{{ 'on' if path.startsWith('/postmortems') }}">Post-Mortems</a>
      <a href="/actions" class="{{ 'on' if path == '/actions' }}">Open Actions</a>
      {% if user.isAdmin %}<a href="/settings" class="{{ 'on' if path.startsWith('/settings') }}">Settings</a>{% endif %}
    </nav>
    <div class="topbar-right">
      {% if mock %}<span class="chip chip-mock" title="Showing fake demo data. Set USE_MOCK_DATA=false in .env to use Epicor.">Demo data</span>{% endif %}
      <a class="who" href="/account" title="Account">{{ user.displayName }} <small>{{ user.role }}</small></a>
      <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="btn btn-ghost btn-sm" type="submit">Sign out</button></form>
    </div>
  </div>
</header>
{% endif %}
<main class="page {% block pageclass %}{% endblock %}">
  <div id="flash">
    {% if ok %}<div class="flash flash-ok">{{ ok }}</div>{% endif %}
    {% if err %}<div class="flash flash-err">{{ err }}</div>{% endif %}
  </div>
  {% block content %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
</body>
</html>
